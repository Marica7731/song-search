[Unit]
Description=culua.com song search service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/culua-web/current
EnvironmentFile=/etc/song-search/song-search.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
User=root
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
